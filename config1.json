{
    "listen": ":19001",
    "upstream": "127.0.0.1:19000",
    "stats_interval": "30s",
    "dial_timeout": "5s",
    "idle_timeout": "5m",
    "log_queries": true,
    "log_data": false,
    "max_query_log_bytes": 300,
    "max_data_log_bytes": 200,
    "metrics_listen": ":19091",
    "auth_enabled": false,
    "rewriter_enabled": true,
    "rewriter_service_addr": "",
    "rewriter_local_indexer_id": 1,
    "rewriter_timeout": "5s",
    "network_state_source": "file",
    "network_state_file": "./rewriter_test_state.yaml",
    "ch_user": "default",
    "ch_password": ""
}