module(
    name = "clickhouse-proxy",
    version = "1.0",
)

bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "protobuf", version = "33.5")
bazel_dep(name = "sentio-core", version = "0.0.0", repo_name = "sentioxyz_sentio_core")

# When clickhouse-proxy is used as root module (standalone build),
# this git_override provides sentio-core.
# When used as a dependency, the parent module's override takes precedence.
git_override(
    module_name = "sentio-core",
    commit = "bc0f931c125858b401be25361637eadf0025f02e",
    patch_strip = 1,
    patches = ["//third_party:sentio-core.patch"],
    remote = "https://github.com/sentioxyz/sentio-core",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.module_override(
    patch_strip = 1,
    patches = ["@sentioxyz_sentio_core//third_party:com_github_ethereum_go_ethereum_secp256k1.patch"],
    path = "github.com/ethereum/go-ethereum",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["@sentioxyz_sentio_core//third_party:com_github_bytedance_sonic.patch"],
    path = "github.com/bytedance/sonic",
)
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "github.com/wasmerio/wasmer-go",
)
go_deps.gazelle_default_attributes(
    directives = ["gazelle:proto disable"],
)
use_repo(
    go_deps,
    "com_github_clickhouse_ch_go",
    "com_github_clickhouse_clickhouse_go_v2",
    "com_github_ethereum_go_ethereum",
    "com_github_prometheus_client_golang",
    "com_github_redis_go_redis_v9",
    "com_github_segmentio_asm",
    "in_yaml_go_yaml_v3",
    "io_opentelemetry_go_otel_trace",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_crypto",
)

bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
)
