{
    "_comment": "Database Context & SHOW TABLES 过滤功能测试配置",
    "_doc": {
        "database_processors": [
            "key   = ClickHouse 实际数据库名",
            "value = processor ID（同时也是物理表名的前缀）",
            "",
            "行为说明：",
            "  1. USE 改写：客户端执行 'USE coinbase' 时，代理自动改写为 'USE sentio_coinbase'，",
            "     ClickHouse 切换到真实数据库，客户端无感知。",
            "     若客户端直接使用 'USE sentio_coinbase' 也可正常工作。",
            "",
            "  2. SHOW TABLES 过滤（三种情况）：",
            "     - currentDB 为空（连接未设置数据库）→ 返回空结果集",
            "     - currentDB 在映射表中（如 sentio_coinbase）→ 只返回以 'coinbase' 开头的物理表",
            "     - currentDB 不在映射表中（如 system/default）→ 原样透传，返回全部表"
        ]
    },

    "listen": ":9001",
    "upstream": "127.0.0.1:9000",

    "stats_interval": "30s",
    "dial_timeout": "5s",
    "idle_timeout": "5m",
    "max_connection_lifetime": "24h",
    "shutdown_timeout": "30s",

    "log_queries": true,
    "log_data": false,
    "max_query_log_bytes": 300,
    "max_data_log_bytes": 200,

    "metrics_listen": ":9091",

    "auth_enabled": false,
    "auth_allow_no_auth": true,

    "rewriter_service_addr": "",
    "rewriter_timeout": "5s",

    "ckh_manager_config_path": "",
    "credential_replace_enabled": false,

    "database_processors": {
        "sentio_coinbase":  "coinbase",
        "sentio_ethereum":  "ethereum",
        "sentio_polygon":   "polygon",
        "sentio_bsc":       "bsc",
        "sentio_avalanche": "avalanche"
    }
}
